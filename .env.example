# Copy to the repository root as `.env`. Docker Compose reads that file.
# uvicorn, Celery, and Alembic load `.env` from the working directory, so when
# you start them from `backend/` also copy this file to `backend/.env`.
#
# The backend, worker, and Beat containers override DATABASE_URL, NEO4J_URI,
# and REDIS_URL with the Docker network hostnames (postgres, neo4j, redis).
# The localhost URLs below are for commands run on the host.

# --- BACKEND CONFIG ---
SECRET_KEY=any-long-random-string
ENVIRONMENT=development

# --- POSTGRES CONFIG ---
# Used by Docker Compose to create the database.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=career_assistant

# Host port is 5433 (docker-compose.yml publishes 5433:5432) so a native
# PostgreSQL on 5432 does not shadow the container. Containers replace this
# URL with postgresql+asyncpg://...@postgres:5432/career_assistant.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/career_assistant

# --- NEO4J CONFIG ---
# Compose sets NEO4J_AUTH from NEO4J_PASSWORD and does not override
# NEO4J_USER or NEO4J_PASSWORD inside the app containers, so these must
# match. NEO4J_URI is overridden to bolt://neo4j:7687 in those containers.
# This URI is for the host (Neo4j Browser: http://localhost:7474).
NEO4J_PASSWORD=password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- REDIS CONFIG ---
# Overridden to redis://redis:6379/0 inside the app containers.
REDIS_URL=redis://localhost:6379/0

# --- AI CONFIG (DeepSeek & Hugging Face) ---
# Required at process start. Embeddings are the local model below; no HF token.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2
HUGGINGFACE_EMBEDDING_DIMENSION=384

# --- EMAIL CONFIG (IMAP) ---
# All four IMAP_* values are required at process start. Placeholders are
# enough to boot; set real credentials before using inbox polling.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
# Verify the IMAP server's TLS certificate (recommended: true).
# Set to false only for trusted internal servers with a self-signed cert.
IMAP_VERIFY_SSL=true
# Optional: path to a CA bundle to verify a self-signed IMAP certificate.
# IMAP_CA_FILE=/path/to/ca.pem

# --- JOB SCRAPING CONFIG ---
# Defaults used when the app does not override a filter on POST /jobs/scrape.
# Scraping is on-demand from the UI (not scheduled on container start).
JOB_SEARCH_TERMS=Python Developer,Software Engineer
JOB_SEARCH_LOCATION=Remote
JOB_SEARCH_SITES=linkedin,indeed
# Code default is 25; this example asks for 50 results per scrape.
JOB_RESULTS_WANTED=50
JOB_SCRAPE_TTL_DAYS=7
JOB_LINKEDIN_FETCH_DESCRIPTION=true
JOB_COUNTRY_INDEED=USA
# Optional comma-separated proxy list for LinkedIn scraping
JOB_PROXIES=
JOB_SCRAPE_REMOTEOK=false
# Rate limiting for LinkedIn/Indeed scraping (jobspy2): results are fetched
# in batches of JOB_SCRAPE_BATCH_SIZE with a JOB_SCRAPE_SLEEP_SECONDS pause
# in between, and retried up to JOB_SCRAPE_MAX_RETRIES times with backoff on
# failure. Raise the sleep time (and consider setting JOB_PROXIES) if you
# still see LinkedIn blocks.
JOB_SCRAPE_BATCH_SIZE=25
JOB_SCRAPE_SLEEP_SECONDS=30
JOB_SCRAPE_MAX_RETRIES=3

# --- OPTIONAL (same values as the defaults in backend/app/config.py) ---
# Person id used by background jobs that have no logged-in request.
# setup_kg.py creates the seeded user's Person as user_{postgres id}.
PRIMARY_PERSON_ID=u1
# Soft daily cap on LLM job-match calls per person (Redis counter).
LLM_MATCH_DAILY_LIMIT=300
# After the free shortlist, only the top K offers are sent to DeepSeek,
# and at most LLM_MATCH_BATCH_MAX offers are considered.
LLM_MATCH_BATCH_TOP_K=25
LLM_MATCH_BATCH_MAX=50

# --- FRONTEND CONFIG ---
# Used when the frontend image is built. `npm run dev` defaults to this
# same URL in code; override it with frontend/.env.local if needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
