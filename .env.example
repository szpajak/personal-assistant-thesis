# --- BACKEND CONFIG ---
SECRET_KEY=any-long-random-string
ENVIRONMENT=development

# --- POSTGRES CONFIG ---
# These are used by Docker Compose to create the database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=career_assistant

# This is used by local scripts (e.g. alembic) when running outside Docker
# Note: Use 'localhost' for local scripts, but Docker uses the 'postgres' service name automatically
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/career_assistant

# --- NEO4J CONFIG ---
# These are used by Docker Compose
NEO4J_PASSWORD=password

# These are used by the app to connect
# Note: BOLT is used for the app driver
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- REDIS CONFIG ---
REDIS_URL=redis://localhost:6379/0

# --- AI CONFIG (DeepSeek & Hugging Face) ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2
HUGGINGFACE_EMBEDDING_DIMENSION=384

# --- EMAIL CONFIG (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
# Verify the IMAP server's TLS certificate (recommended: true).
# Set to false only for trusted internal servers with a self-signed cert.
IMAP_VERIFY_SSL=true
# Optional: path to a CA bundle to verify a self-signed IMAP certificate.
# IMAP_CA_FILE=/path/to/ca.pem

# --- JOB SCRAPING CONFIG ---
# Defaults used when the app does not override a filter on POST /jobs/scrape.
# Scraping is on-demand from the UI (not scheduled on container start).
JOB_SEARCH_TERMS=Python Developer,Software Engineer
JOB_SEARCH_LOCATION=Remote
JOB_SEARCH_SITES=linkedin,indeed
JOB_RESULTS_WANTED=50
JOB_SCRAPE_TTL_DAYS=7
JOB_LINKEDIN_FETCH_DESCRIPTION=true
JOB_COUNTRY_INDEED=USA
# Optional comma-separated proxy list for LinkedIn scraping
JOB_PROXIES=
JOB_SCRAPE_REMOTEOK=false
# Rate limiting for LinkedIn/Indeed scraping (jobspy2): results are fetched
# in batches of JOB_SCRAPE_BATCH_SIZE with a JOB_SCRAPE_SLEEP_SECONDS pause
# in between, and retried up to JOB_SCRAPE_MAX_RETRIES times with backoff on
# failure. Raise the sleep time (and consider setting JOB_PROXIES) if you
# still see LinkedIn blocks.
JOB_SCRAPE_BATCH_SIZE=25
JOB_SCRAPE_SLEEP_SECONDS=30
JOB_SCRAPE_MAX_RETRIES=3

# --- FRONTEND CONFIG ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
